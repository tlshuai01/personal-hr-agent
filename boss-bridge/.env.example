# Boss Bridge 环境变量（复制为 .env）
BOSS_CLI_BIN=boss
# Windows 若 PATH 无 boss：写全路径，例如
# BOSS_CLI_BIN=C:/Users/you/AppData/Local/Python/pythoncore-3.14-64/Scripts/boss.exe
BOSS_CLI_TIMEOUT_SEC=60

AGENT_BASE_URL=http://127.0.0.1:3000
BOSS_BRIDGE_SECRET=change-me-bridge-secret
AGENT_TIMEOUT_SEC=120

POLL_INTERVAL_SEC=25
SEND_DELAY_SEC=3
HISTORY_LIMIT=20
LOG_LEVEL=INFO

# 回复范围：new=启动时忽略当前积压，只回之后新消息（默认）
# unread=仅 unreadCount>0；all=对方最后一条都处理（含历史）
REPLY_MODE=new

# C1/C2 持续轮询：每轮最多处理会话数
MAX_PER_POLL=5

# DANGEROUS: real attachment resume send. Default off in example; local C2 may set true.
# Needs cookie `bst` → header zp_token (zhipin-geek). Without it Boss returns 121.
# Single-shot test: python scripts/send_resume_once.py --session-id <encryptUid>
BOSS_ENABLE_SEND_RESUME=false

# DANGEROUS: real job greet (friend/add). Default off. Use scripts/search_and_greet.py --force
BOSS_ENABLE_GREET=false
GREET_DELAY_SEC=1.5
