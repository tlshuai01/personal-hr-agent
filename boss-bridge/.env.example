# Boss Bridge 环境变量（复制为 .env）
BOSS_CLI_BIN=boss
# Windows 若 PATH 无 boss：写全路径，例如
# BOSS_CLI_BIN=C:/Users/you/AppData/Local/Python/pythoncore-3.14-64/Scripts/boss.exe
BOSS_CLI_TIMEOUT_SEC=60

AGENT_BASE_URL=http://127.0.0.1:3000
BOSS_BRIDGE_SECRET=change-me-bridge-secret
AGENT_TIMEOUT_SEC=120

POLL_INTERVAL_SEC=25
SEND_DELAY_SEC=3
HISTORY_LIMIT=20
LOG_LEVEL=INFO

# DANGEROUS: real attachment resume send (HTTP/CDP). Default off.
# Probe hit Boss code=36 (账户异常行为) — cool down before enabling.
# Even when true, transport.send_resume still raises until reverse is confirmed.
BOSS_ENABLE_SEND_RESUME=false
